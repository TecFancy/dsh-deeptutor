{
  "name": "dsh-deeptutor",
  "version": "0.1.9",
  "description": "Learning assistant extension for DeepSeek Harness (dsh): DeepTutor tutoring for your agent — deep explanations, self-test questions, learning paths, personal knowledge-base search (RAG), and note archiving (HTTP/WS first, CLI fallback; auto-adapts local/remote deployment).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deeptutor",
    "tutoring",
    "rag",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TecFancy/dsh-deeptutor.git"
  },
  "homepage": "https://github.com/TecFancy/dsh-deeptutor",
  "bugs": {
    "url": "https://github.com/TecFancy/dsh-deeptutor/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-deeptutor": "scripts/install-profile.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./scripts/*": "./scripts/*",
    "./skills/*": "./skills/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && npm run typecheck",
    "pack:check": "npm pack --dry-run",
    "test": "node --test --experimental-strip-types"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
